<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtStock Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .btn-purple {
            background-color: #8b3fa3;
            border-color: #8b3fa3;
            color: white;
        }
        .btn-purple:hover {
            background-color: #6d2e7f;
            border-color: #6d2e7f;
            color: white;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-5"><b> ArtStock: Análisis de Inventario</b></h1>
            <a href="/crear" class="btn btn-purple btn-lg">+ Añadir Producto</a>
        </div>

        <div class="row mb-5">
            <div class="col-md-10 mx-auto">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h5 class="card-title text-center mb-4">Comparativa de Productos (Stock, Ventas y Costos)</h5>
                        
                        <div class="mb-4">
                            <p class="text-muted text-center mb-2">Selecciona los productos que deseas comparar:</p>
                            <div class="d-flex flex-wrap justify-content-center gap-2" id="chart-product-selectors">
                                <% productos.forEach(p => { %>
                                    <div class="form-check form-check-inline bg-light border rounded px-3 py-1 shadow-sm">
                                        <input class="form-check-input product-checkbox mt-1" type="checkbox" id="chk_<%= p.id %>" value="<%= p.id %>">
                                        <label class="form-check-label fw-bold ms-1" for="chk_<%= p.id %>"><%= p.nombre %></label>
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <div style="position: relative; height:40vh; width:100%">
                            <canvas id="graficaInventario"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Detalle de Existencias</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle shadow-sm">
    <thead class="table-dark text-center">
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Costo</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th> </tr>
    </thead>
    <tbody>
        <% productos.forEach(p => { %>
            <tr class="text-center">
                <td><%= p.nombre %></td>
                <td><span class="badge bg-secondary"><%= p.categoria %></span></td>
                <td>$<%= p.costo %></td>
                <td>$<%= p.precio %></td>
                <td><span class="badge bg-success"><%= p.stock %> und.</span></td>
                <td>
                    <a href="/editar/<%= p.id %>" class="btn btn-outline-warning btn-sm me-1 fw-bold">
                        Editar
                    </a>
                    <a href="/eliminar/<%= p.id %>" 
                       class="btn btn-outline-danger btn-sm fw-bold" 
                       onclick="return confirm('¿Estás seguro de eliminar este producto?')">
                       Eliminar
                    </a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
                </div>
            </div>
        </div>
    </div>

    <script src="/grafica.js"></script>
    
    <script id="productos-data" type="application/json">
        <%- JSON.stringify(productos) %>
    </script>
    <script>
        // Leemos los datos desde el script JSON para que el editor no marque errores de sintaxis
        const misProductos = JSON.parse(document.getElementById('productos-data').textContent);
        
        // Renderizamos una gráfica vacía al iniciar
        renderMyChart([]);

        // Añadimos eventos a todos los checkboxes
        const checkboxes = document.querySelectorAll('.product-checkbox');
        checkboxes.forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                // Obtenemos los IDs seleccionados
                const selectedIds = Array.from(document.querySelectorAll('.product-checkbox:checked')).map(cb => cb.value);
                
                // Filtramos los productos según los seleccionados
                const datosAFiltrar = misProductos.filter(p => selectedIds.includes(p.id.toString()));
                
                // Volvemos a renderizar
                renderMyChart(datosAFiltrar);
            });
        });
    </script>
</body>
</html>
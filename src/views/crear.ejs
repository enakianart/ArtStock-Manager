<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Añadir Producto - ArtStock</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0">Nuevo Artículo</h3>
                    </div>
                    <div class="card-body">
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-warning" role="alert">
                                <strong>Atención:</strong> <%= error %>
                            </div>
                        <% } %>
                        <form action="/crear" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Nombre del Producto</label>
                                <input type="text" name="nombre" class="form-control" value="<%= (typeof values !== 'undefined' && values.nombre) ? values.nombre : '' %>" required>
                            </div>
                            <div class="col mb-3">
                                <label class="form-label">Categoría</label>
                                <select name="categoria" class="form-select">
                                    <option value="Stickers" <%= (typeof values !== 'undefined' && values.categoria === 'Stickers') ? 'selected' : '' %>>Stickers</option>
                                    <option value="Posters" <%= (typeof values !== 'undefined' && values.categoria === 'Posters') ? 'selected' : '' %>>Posters</option>
                                    <option value="Pines" <%= (typeof values !== 'undefined' && values.categoria === 'Pines') ? 'selected' : '' %>>Pines</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Costo de Producción </label>
                                <input type="number" step="0.01" name="costo" class="form-control" placeholder="0.00" value="<%= (typeof values !== 'undefined' && values.costo) ? values.costo : '' %>" required>
                            </div>
                            <div class="col mb-3">
                                <label class="form-label">Precio</label>
                                <input type="number" name="precio" step="0.01" class="form-control" value="<%= (typeof values !== 'undefined' && values.precio) ? values.precio : '' %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Stock Inicial</label>
                                <input type="number" name="stock" class="form-control" value="<%= (typeof values !== 'undefined' && values.stock) ? values.stock : '' %>" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Guardar en Inventario</button>
                            <a href="/" class="btn btn-secondary w-100 mt-2">Cancelar</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
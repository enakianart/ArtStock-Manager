<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Producto - ArtStock</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-warning text-dark">
                        <h3 class="mb-0">Editar Artículo</h3>
                    </div>
                    <div class="card-body">
                        <form action="/editar/<%= p.id %>" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Nombre del Producto</label>
                                <input type="text" name="nombre" class="form-control" value="<%= p.nombre %>" required>
                            </div>
                            <div class="col mb-3">
                                <label class="form-label">Categoría</label>
                                <select name="categoria" class="form-select">
                                    <option value="Stickers" <%= p.categoria === 'Stickers' ? 'selected' : '' %>>Stickers</option>
                                    <option value="Posters" <%= p.categoria === 'Posters' ? 'selected' : '' %>>Posters</option>
                                    <option value="Pines" <%= p.categoria === 'Pines' ? 'selected' : '' %>>Pines</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Costo de Producción </label>
                                <input type="number" step="0.01" name="costo" class="form-control" value="<%= p.costo %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Precio</label>
                                <input type="number" name="precio" step="0.01" class="form-control" value="<%= p.precio %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Stock Actual</label>
                                <input type="number" name="stock" class="form-control" value="<%= p.stock %>" required>
                            </div>
                            <button type="submit" class="btn btn-warning w-100">Actualizar Producto</button>
                            <a href="/" class="btn btn-secondary w-100 mt-2">Cancelar</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
